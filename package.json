{
  "name": "archipielago-virtux",
  "productName": "Virtual Experience Engineering SAS",
  "private": true,
  "version": "0.1.0",
  "description": "Archipiélago VirtuX: experiencia educativa inmersiva para el ecosistema VirtuXperience de UNIMINUTO.",
  "author": "Mario Mendoza Huertas",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.js",
  "desktopName": "archipielago-virtux.desktop",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "server": "node --env-file-if-exists=.env server/dev.ts",
    "electron:dev": "tsc -p tsconfig.electron.json && electron . --dev",
    "electron:start": "pnpm build && electron .",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never",
    "test:electron": "playwright test -c playwright.electron.config.ts",
    "evidencias": "playwright test -c playwright.evidencias.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.8.0",
    "electron-builder": "26.17.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{js,css,json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
