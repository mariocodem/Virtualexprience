# Proxy de IA de Brújula y la Bruma (server/ y api/). Nunca se expone al navegador.
# Sin LLM_API_KEY todo funciona igual con el motor local («Modo sin conexión»).

# groq | gemini | openrouter (o cualquier API compatible con OpenAI usando LLM_BASE_URL)
LLM_PROVIDER=groq
# Clave del plan gratuito del proveedor (Groq: console.groq.com · Gemini: aistudio.google.com)
LLM_API_KEY=
# Opcional: cambia el modelo del preset (p. ej. openai/gpt-oss-20b en Groq)
LLM_MODEL=
# Opcional: URL base de otra API compatible con OpenAI
LLM_BASE_URL=
# Opcional: dominio del frontend desplegado, para restringir el origen (CORS)
ALLOWED_ORIGIN=

# Solo para el ejecutable o despliegues separados: URL pública del proxy
# VITE_BRUJULA_URL=https://tu-proyecto.vercel.app/api/brujula
